DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=jungle_wagering
DB_USER=jungle_app
DB_PASSWORD=defina-uma-senha-local
PORT=3001
TEST_DB_NAME=jungle_wagering_test

SQS_ENABLED=true
SQS_ENDPOINT=http://127.0.0.1:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo
SQS_AUTO_CREATE_QUEUES=false
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_WAIT_TIME_SECONDS=10

WORKER_SQS_CONSUMER=true
WORKER_OUTBOX_PUBLISHER=true
WORKER_PENDING_REFERENCES=true
WORKER_RECONCILIATION=true
OUTBOX_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_INTERVAL_MS=5000
PENDING_REFERENCE_TTL_MS=86400000
PENDING_REFERENCE_MAX_ATTEMPTS=50
RECONCILIATION_INTERVAL_MS=300000
